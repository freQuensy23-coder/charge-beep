#!/bin/bash
set -euo pipefail
[[ "${3:-/}" == / ]] || { echo "Install only on the startup volume." >&2; exit 1; }
app='/Applications/Charge Beep.app'
cli='/usr/local/bin/charge-beep'
label='io.github.frequensy23.charge-beep'
if [[ -e "$app" ]]; then
  identifier=$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null || true)
  [[ "$identifier" == "$label.ui" ]] || { echo "Refusing to replace an unrelated app: $app" >&2; exit 1; }
fi
if [[ -e "$cli" || -L "$cli" ]]; then
  [[ -L "$cli" && "$(readlink "$cli")" == "$app/Contents/MacOS/charge-beep" ]] || {
    echo "Refusing to overwrite an unrelated $cli" >&2; exit 1;
  }
fi
while read -r name uid; do
  [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 500 ]] || continue
  /bin/launchctl bootout "gui/$uid/$label" 2>/dev/null || true
done < <(/usr/bin/dscl . -list /Users UniqueID)
